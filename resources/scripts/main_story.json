        "text": "D. 我帮你一起实现吧。",
        "next": {
          "type": "jump",
          "target": "c7_D"
        }
      },
      {
        "text": "……（默然倾听）",
        "next": {
          "type": "jump",
          "target": "ch3_cafe_continue"
        }
      }
    ]
  },
  {
    "type": "scene",
